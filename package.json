{
  "name": "arvind-resume",
  "description": "Resume of Arvind Srinivasan",
  "scripts": {
    "serve": "rm -rf _site && npx @11ty/eleventy --serve --quiet & npx tailwindcss -i ./src/tailwind.css -o ./_site/styles.css --watch",
    "build": "rm -rf _site && ELEVENTY_ENV=production npx @11ty/eleventy && npx tailwindcss -i ./src/tailwind.css -o ./_site/styles.css --minify",
    "build-ghpages": "rm -rf _site && ELEVENTY_ENV=production npx @11ty/eleventy && npx tailwindcss -i ./src/tailwind.css -o ./_site/styles.css --minify",
    "clean": "rm -rf _site",
    "debug": "DEBUG=Eleventy* npx @11ty/eleventy"
  },
  "keywords": [
    "eleventy",
    "tailwindcss",
    "starter"
  ],
  "author": "Arvind Srinivasan",
  "license": "MIT",
  "type": "module",
  "browserslist": "defaults, not ie <= 11",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "tailwindcss": "^3.4.14"
  },
  "dependencies": {
    "luxon": "^3.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

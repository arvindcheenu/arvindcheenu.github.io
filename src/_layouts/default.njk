<!DOCTYPE html>
<html class="overflow-y-scroll" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover" />
    <meta name="description" content="{% if description %}{{ description }}{% else %}Your site description{% endif %}" />
    <meta name="generator" content="{{ eleventy.generator }}">
    <title>{% if title %}{{ title }} | {% endif %}Arvind Srinivasan</title>
    <link rel="stylesheet" href="/styles.css" />
    <script defer src="/alpine.focus.min.js"></script>
    <script defer src="/alpine.min.js"></script>
    <style>
      @media (prefers-color-scheme: dark) {
        html, body {
          background-color: rgb(18, 15, 15);
        }
      }
      [x-cloak] {
        display: none !important;
      }
    </style>
  </head>
  <body>
    {{ content | safe }}
  </body>
</html>

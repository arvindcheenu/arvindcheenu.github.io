---
permalink: /index.html
---
{#- Everything visible comes from src/_data/site.yaml. This file only arranges it. -#}
{%- set s = site -%}
{%- set kinds = { journal: "Journal", conference: "Conference", article: "Article", short: "Short paper", workshop: "Workshop", abstract: "Extended abstract", demo: "Demo", poster: "Poster", preprint: "Preprint", thesis: "Thesis" } -%}
{%- set statuses = { "to-appear": "To appear", "under-review": "Under review" } -%}
{%- set projectKinds = { library: "Library", tool: "Tool", research: "Research", game: "Game", infrastructure: "Infrastructure" } -%}
{%- set actLabels = { pdf: "PDF", doi: "DOI", arxiv: "arXiv", code: "Code", video: "Video", blog: "Blog", supplement: "Supplement", poster: "Poster", web: "Web" } -%}
{%- macro icon(name, brand=false, cls="") -%}<i class="{% if brand %}fa-brands{% elif site.fontawesome_kit %}fa-duotone fa-solid{% else %}fa-solid{% endif %} fa-{{ name }}{% if cls %} {{ cls }}{% endif %}" aria-hidden="true"></i>{%- endmacro -%}
{%- macro edge(pos) -%}<div class="edge {{ pos }}" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><b></b></div>{%- endmacro -%}
<!doctype html>
<html lang="en" class="at-top" data-sound="{{ 'on' if (s.sound_default | isOn) else 'off' }}" data-base="{{ s.url }}" data-tz="{{ s.timezone }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ s.name }} · {{ s.role }}</title>
<meta name="description" content="{{ s.bio | join(' ') | md | striptags | truncate(155, true, '…') }}">
<link rel="canonical" href="{{ s.url }}/">
<meta property="og:type" content="profile">
<meta property="og:title" content="{{ s.name }}">
<meta property="og:description" content="{{ s.role }}">
<meta property="og:url" content="{{ s.url }}/">
{%- if s.og_image or s.photo %}
<meta property="og:image" content="{{ s.url }}/{{ s.og_image or s.photo }}">{% endif %}
<meta name="twitter:card" content="summary">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@400..700&display=swap">
<script>
/* Runs before paint so the saved theme and sound setting never flash. */
(function(){var d=document.documentElement,g=function(k){try{return localStorage.getItem(k)}catch(e){return null}};
var t=g("theme");if(t==="light"||t==="dark")d.dataset.theme=t;
var sn=g("sound");if(sn==="on"||sn==="off")d.dataset.sound=sn;})();
</script>
<style>
{% inline "site.css" %}
</style>
{%- if s.fontawesome_kit %}
<script src="https://kit.fontawesome.com/{{ s.fontawesome_kit }}.js" crossorigin="anonymous" async></script>
{%- else %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" media="print" onload="this.media='all'" crossorigin="anonymous" referrerpolicy="no-referrer">
{%- endif %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Person","name":{{ s.name | json | safe }},"url":{{ s.url | json | safe }},"email":{{ ("mailto:" + s.email) | json | safe }},"jobTitle":{{ s.role | json | safe }},"affiliation":{"@type":"CollegeOrUniversity","name":"Aarhus University"},"address":{"@type":"PostalAddress","addressLocality":"Aarhus","addressCountry":"DK"},"sameAs":{{ s.links | sameAs | safe }}}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{{ edge("top") }}
{{ edge("bottom") }}

<header class="topbar" id="topbar">
  <div class="wrap bar">
    <a class="brand" href="#top" aria-label="{{ s.name }}, back to top"><span class="mono" aria-hidden="true">{{ s.short }}</span><span class="brand-name">{{ s.name }}</span></a>
    <div class="controls">
      <button type="button" class="btn icon tac" data-action="sound" data-sfx="none" aria-label="Sound effects" title="Sound effects">{{ icon("volume-high", false, "i-on") }}{{ icon("volume-xmark", false, "i-off") }}<span class="fb">Sound</span></button>
      <button type="button" class="btn icon tac" data-action="theme" aria-label="Colour theme: system" title="Colour theme">{{ icon("circle-half-stroke", false, "i-system") }}{{ icon("sun", false, "i-light") }}{{ icon("moon", false, "i-dark") }}<span class="fb">Theme</span></button>
      <button type="button" class="btn tac cv-btn" data-action="print" title="Save this CV as PDF">{{ icon("file-arrow-down") }}<span>CV</span></button>
    </div>
  </div>
</header>

<main id="main" class="wrap">
  <section class="hero" id="top" aria-label="Introduction">
    <div class="avatar" style="--i:0">
      {%- if s.ring %}
      <svg class="ring" viewBox="0 0 132 132" aria-hidden="true">
        <defs><path id="ring-path" d="M66,66 m-54,0 a54,54 0 1,1 108,0 a54,54 0 1,1 -108,0"/></defs>
        <text><textPath href="#ring-path" textLength="336" lengthAdjust="spacing">{{ s.ring }}</textPath></text>
      </svg>
      {%- endif %}
      <div class="face">
        {%- if s.photo %}<img src="{{ s.photo }}" alt="Portrait of {{ s.name }}" width="184" height="184" fetchpriority="high" decoding="async">{% else %}<span aria-hidden="true">{{ s.short }}</span>{% endif -%}
      </div>
    </div>
    <div class="intro" style="--i:1">
      <h1 class="name">{{ s.name }}</h1>
      <p class="role">{{ s.role }}</p>
      {%- if s.status %}<p class="status no-print"><span class="dot" aria-hidden="true"></span>{{ s.status }}</p>{% endif %}
      <p class="print-only contact-line"><a href="mailto:{{ s.email }}">{{ s.email }}</a> · <a href="{{ s.url }}">{{ s.url | host }}</a> · {{ s.location }}{% for l in s.links %}{% if l.brand %} · <a href="{{ l.url }}">{{ l.label }}</a>{% endif %}{% endfor %}</p>
    </div>
    <div class="bio" style="--i:2">
      {%- for para in s.bio %}<p>{{ para | md | safe }}</p>{% endfor %}
    </div>
    <div class="actions no-print" style="--i:3">
      <div class="links">
        {%- for l in s.links %}{% if l.primary %}
        <a class="btn tac primary" href="{{ l.url }}">{{ icon(l.icon, l.brand) }}<span>{{ l.label }}</span></a>
        {%- endif %}{% endfor %}
        <button type="button" class="btn tac" data-action="print">{{ icon("file-arrow-down") }}<span>Download CV</span></button>
      </div>
      <ul class="profiles" aria-label="Profiles">
        {%- for l in s.links %}{% if not l.primary %}
        <li><a href="{{ l.url }}"{% if l.url.startsWith('http') %} rel="me noopener"{% endif %}>{{ icon(l.icon, l.brand) }}{{ l.label }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
    </div>
  </section>

  {%- for key in s.order %}
  {%- set title = s.sections[key] %}
  {%- if s[key] and s[key].length %}
  <section class="sec" id="{{ key }}" aria-labelledby="h-{{ key }}">
    <h2 class="sec-label rv" id="h-{{ key }}">{{ title | md | safe }}</h2>
    <div class="list">

    {%- if key == "news" %}
      {%- for n in s.news %}
      <article class="item rv{% if loop.index > s.news_visible %} fold{% endif %}">
        <div class="when"><time datetime="{{ n.date }}">{{ n.date | ym }}</time></div>
        <div class="what">
          <div class="main"><p class="text">{{ n.text | md | safe }}{% if n.link %} <a class="more" href="{{ n.link }}" aria-label="Read more">↗</a>{% endif %}</p></div>
          {%- if n.image %}<img class="thumb" src="{{ n.image }}" alt="{{ n.image_alt or '' }}" loading="lazy" decoding="async">{% endif %}
        </div>
      </article>
      {%- endfor %}
      {%- if s.news.length > s.news_visible %}
      <div class="item fold-row no-print"><div class="when"></div><div class="what"><button type="button" class="tl fold-btn" data-action="fold" aria-expanded="false"><span>Show all {{ s.news.length }}</span></button></div></div>
      {%- endif %}

    {%- elif key == "publications" %}
      {%- for row in s.publications | pubRows %}
      {%- set p = row.p -%}
      {%- set url = p | primaryUrl -%}
      <article class="item rv{% if row.repR %} rep{% endif %}" data-kind="{{ p.kind }}">
        <div class="when">{{ row.label }}</div>
        <div class="what">
          <div class="main">
            <h3 class="t">{% if url %}<a href="{{ url }}">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</h3>
            <p class="sub">{{ p.authors | authors(s.name, p.equal or []) | safe }}</p>
            <p class="sub">{{ p.venue }}<span class="sep">·</span>{{ kinds[p.kind] or p.kind }}{% if statuses[p.status] %}<span class="sep">·</span>{{ statuses[p.status] }}{% endif %}{% if p.award %}<span class="sep">·</span><span class="hl">{{ p.award }}</span>{% endif %}</p>
            <p class="print-only ref">{% if p.doi %}doi:{{ p.doi }}{% elif p.links and p.links.arxiv %}arXiv:{{ p.links.arxiv | replace("https://arxiv.org/abs/", "") }}{% endif %}</p>
            {%- if p.doi or p.links or p.bibtex !== false %}
            <p class="acts no-print">
              {%- for k, u in p.links %}{% if k == "pdf" %}<a class="tl" href="{{ u }}">PDF</a>{% endif %}{% endfor %}
              {%- if p.doi %}<a class="tl" href="https://doi.org/{{ p.doi }}">DOI</a>{% endif %}
              {%- for k, u in p.links %}{% if k != "pdf" %}<a class="tl" href="{{ u }}">{{ actLabels[k] or k }}</a>{% endif %}{% endfor %}
              {%- if p.bibtex !== false %}<button type="button" class="tl" data-action="copy" data-copy="{{ p | bibtex(s.name) }}" data-toast="BibTeX copied">BibTeX</button>{% endif %}
            </p>
            {%- endif %}
          </div>
          {%- if p.image %}<img class="thumb" src="{{ p.image }}" alt="" loading="lazy" decoding="async">{% endif %}
        </div>
      </article>
      {%- endfor %}
      {%- if s.publications | selectattr("equal") | length %}
      <p class="item foot-note rv"><span class="when"></span><span class="what">† Equal contribution</span></p>
      {%- endif %}

    {%- elif key == "projects" %}
      {%- for p in s.projects %}
      {%- set purl = (p.links.web if p.links else "") or (p.links.code if p.links else "") -%}
      <article class="item rv">
        <div class="when">{{ projectKinds[p.kind] or p.kind }}</div>
        <div class="what">
          <div class="main">
            <h3 class="t">{% if purl %}<a href="{{ purl }}">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</h3>
            <p class="sub">{{ p.summary | md | safe }}</p>
            {%- if p.tech %}<p class="sub tech">{{ p.tech | join(" · ") }}</p>{% endif %}
            {%- if p.links %}<p class="acts no-print">{% for k, u in p.links %}<a class="tl" href="{{ u }}">{{ "Live" if k == "web" else (actLabels[k] or k) }}</a>{% endfor %}</p>{% endif %}
          </div>
          {%- if p.image %}<img class="thumb" src="{{ p.image }}" alt="" loading="lazy" decoding="async">{% endif %}
        </div>
      </article>
      {%- endfor %}

    {%- elif key == "experience" %}
      {%- for e in s.experience %}
      <article class="item rv">
        <div class="when">{{ e | period }}</div>
        <div class="what"><div class="main">
          <h3 class="t">{{ e.role }}</h3>
          <p class="sub">{{ e.org }}{% if e.place %}, {{ e.place }}{% endif %}</p>
          {%- if e.summary %}<p class="text">{{ e.summary | md | safe }}</p>{% endif %}
          {%- if e.tags %}<p class="sub tech">{{ e.tags | join(" · ") }}</p>{% endif %}
        </div></div>
      </article>
      {%- endfor %}

    {%- elif key == "teaching" %}
      {%- for t in s.teaching %}
      <article class="item rv">
        <div class="when">{{ t.when }}</div>
        <div class="what"><div class="main"><h3 class="t">{{ t.role }}</h3><p class="sub">{{ t.org }}</p>{% if t.detail %}<p class="text">{{ t.detail | md | safe }}</p>{% endif %}</div></div>
      </article>
      {%- endfor %}

    {%- elif key == "talks" %}
      {%- for t in s.talks %}
      <article class="item rv">
        <div class="when">{{ t.date | ym }}</div>
        <div class="what"><div class="main"><h3 class="t">{% if t.link %}<a href="{{ t.link }}">{{ t.title }}</a>{% else %}{{ t.title }}{% endif %}</h3><p class="sub">{{ t.event }}</p></div></div>
      </article>
      {%- endfor %}

    {%- elif key == "service" %}
      {%- for r in s.service %}
      <article class="item rv">
        <div class="when">{{ r.venue | year4 }}</div>
        <div class="what"><div class="main"><h3 class="t">{{ r.venue | noYear }}, {{ r.track }}</h3><p class="sub">{{ r.reviews }} review{% if r.reviews != 1 %}s{% endif %}{% if r.note %}<span class="sep">·</span><span class="hl">{{ r.note }}</span>{% endif %}</p></div></div>
      </article>
      {%- endfor %}

    {%- elif key == "awards" %}
      {%- for a in s.awards %}
      <article class="item rv">
        <div class="when">{{ a.year }}</div>
        <div class="what"><div class="main"><h3 class="t">{{ a.title }}</h3><p class="sub">{{ a.by }}</p>{% if a.for %}<p class="sub">For {% if a.link %}<a href="{{ a.link }}">{{ a.for }}</a>{% else %}{{ a.for }}{% endif %}</p>{% endif %}</div></div>
      </article>
      {%- endfor %}

    {%- elif key == "education" %}
      {%- for e in s.education %}
      <article class="item rv">
        <div class="when">{{ e | period }}</div>
        <div class="what"><div class="main"><h3 class="t">{{ e.degree }}</h3><p class="sub">{{ e.org }}{% if e.place %}, {{ e.place }}{% endif %}</p>{% if e.detail %}<p class="text">{{ e.detail | md | safe }}</p>{% endif %}</div></div>
      </article>
      {%- endfor %}

    {%- elif key == "skills" %}
      {%- for g in s.skills %}
      <article class="item rv">
        <div class="when">{{ g.group }}</div>
        <div class="what"><div class="main"><p class="text">{{ g.items | join(", ") }}</p></div></div>
      </article>
      {%- endfor %}

    {%- elif key == "elsewhere" %}
      {%- for e in s.elsewhere %}
      <article class="item rv">
        <div class="when">{{ e.kind }}</div>
        <div class="what"><div class="main"><h3 class="t"><a href="{{ e.url }}">{{ e.label }}</a></h3>{% if e.detail %}<p class="sub">{{ e.detail | md | safe }}</p>{% endif %}</div></div>
      </article>
      {%- endfor %}
    {%- endif %}

    </div>
  </section>
  {%- endif %}
  {%- endfor %}

  <section class="sec contact no-print" id="contact" aria-labelledby="h-contact">
    <h2 class="sec-label rv" id="h-contact">Contact</h2>
    <div class="list">
      <div class="item rv">
        <div class="when">Email</div>
        <div class="what"><div class="main">
          <p class="t"><a href="mailto:{{ s.email }}">{{ s.email }}</a></p>
          <p class="sub">{% if s.work_email %}University <a href="mailto:{{ s.work_email }}">{{ s.work_email }}</a><span class="sep">·</span>{% endif %}{{ s.location }}<span class="sep">·</span><span class="clock" data-clock>&nbsp;</span></p>
        </div></div>
      </div>
      <div class="item rv">
        <div class="when">Message</div>
        <div class="what"><div class="main">
          {%- set cf = s.contact_form or {} %}
          <form class="form" id="contact-form" novalidate data-endpoint="{{ cf | formEndpoint }}" data-key="{{ cf.access_key }}" data-subject="{{ cf.subject }}" data-to="{{ s.email }}">
            <div class="field">
              <label for="cf-name">Name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="cf-email">Email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required>
            </div>
            <div class="field wide">
              <label for="cf-message">Message</label>
              <textarea id="cf-message" name="message" rows="5" required></textarea>
            </div>
            <input class="hp" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true">
            <div class="form-foot wide">
              <button type="submit" class="btn tac primary">{{ icon("paper-plane") }}<span>Send message</span></button>
              <button type="button" class="btn tac" data-action="copy" data-copy="{{ s.email }}" data-toast="Email address copied">{{ icon("copy") }}<span>Copy email</span></button>
              <p class="form-status" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div></div>
      </div>
    </div>
  </section>
</main>

<footer class="wrap foot no-print">
  <p>© {% buildYear %} {{ s.name }}<span class="sep">·</span>Updated {% buildDate %}<span class="sep">·</span><a href="#top">Back to top</a></p>
</footer>

<div class="qr-pop" aria-hidden="true"><div class="qr-code"></div><div class="qr-cap"></div></div>
<div class="toast" role="status" aria-live="polite"></div>

<script>
{% inline "site.js" %}
</script>
</body>
</html>

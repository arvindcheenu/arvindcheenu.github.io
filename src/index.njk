---
permalink: /index.html
---
{#- Everything visible comes from src/_data/site.yaml. This file only arranges it. -#}
{%- set s = site -%}
{%- set views = s.tailor.views -%}
{%- set dv = s.tailor.default or "research" -%}
{%- set cur = s.currency_default or "EUR" -%}
{%- set bioR = s.bio.research or s.bio -%}
{%- set awardRefs = s.awards | pluck("ref") -%}
{%- set kindIcon = { home: "house", stay: "briefcase", talk: "microphone-lines", school: "graduation-cap" } -%}
{%- set kindColor = { home: "sky", stay: "indigo", talk: "fuchsia", school: "amber" } -%}
{%- set kindName = { home: "Home", stay: "Research stay", talk: "Talk", school: "Summer school" } -%}
{%- set projectKinds = { library: "Library", tool: "Tool", research: "Research", game: "Game", infrastructure: "Infrastructure" } -%}
{%- set actLabels = { pdf: "PDF", doi: "DOI", arxiv: "arXiv", code: "Code", video: "Video", blog: "Blog", supplement: "Supplement", poster: "Poster", web: "Project page", proquest: "ProQuest" } -%}
{%- set actIcons = { pdf: "file-pdf", doi: "link", arxiv: "file-lines", code: "code", video: "circle-play", blog: "pen-nib", supplement: "folder-open", poster: "image", web: "globe", proquest: "book" } -%}
{%- macro icon(name, brand=false, cls="") -%}{{ name | svgIcon(brand, cls) | safe }}{%- endmacro -%}
{%- macro edge(pos) -%}<div class="edge {{ pos }}" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><b></b></div>{%- endmacro -%}
{%- macro perView(field) -%}{% for k, v in views %}<span data-only="{{ k }}">{{ v[field] }}</span>{% endfor %}{%- endmacro -%}
{%- macro head(key, sec, note="") -%}
    <div class="sec-head rv">
      <div class="sec-title">
        <h2 class="sec-label" id="h-{{ key }}">{% if sec.icon %}<span class="sec-ic">{{ icon(sec.icon) }}</span>{% endif %}<span>{{ sec.title | md | safe }}</span></h2>
      </div>
      {%- if caller %}{{ caller() }}{% endif %}
      {%- if note %}<p class="sec-note">{{ note | safe }}</p>{% endif %}
    </div>
{%- endmacro -%}
<!doctype html>
<html lang="en" class="at-top" data-tailor="{{ dv }}" data-default-tailor="{{ dv }}" data-sound="{{ 'on' if (s.sound_default | isOn) else 'off' }}" data-currency="{{ cur }}" data-base="{{ s.url }}" data-tz="{{ s.timezone }}"{% if s.analytics and s.analytics.gtm %} data-gtm="{{ s.analytics.gtm }}" data-gtm-host="{{ s.analytics.host }}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ s.name }} · {{ s.role }}</title>
<meta name="description" content="{{ bioR | join(' ') | md | striptags | truncate(155, true, '…') }}">
<link rel="canonical" href="{{ s.url }}/">
<meta property="og:type" content="profile">
<meta property="og:title" content="{{ s.name }}">
<meta property="og:description" content="{{ s.role }}, {{ s.affiliation }}">
<meta property="og:url" content="{{ s.url }}/">
{%- if s.og_image or s.photo %}
<meta property="og:image" content="{{ s.url }}/{{ s.og_image or s.photo }}">{% endif %}
<meta name="twitter:card" content="summary">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#18181b" media="(prefers-color-scheme: dark)">
<link rel="icon" href="favicon.png" type="image/png" sizes="64x64">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<script>
/* Runs before paint so the saved theme, sound, view and currency never flash.
   ?for=industry in the address opens that view. */
(function(){var d=document.documentElement,g=function(k){try{return localStorage.getItem(k)}catch(e){return null}};
var t=g("theme");if(t==="light"||t==="dark")d.dataset.theme=t;
var sn=g("sound");if(sn==="on"||sn==="off")d.dataset.sound=sn;
var views={{ views | keys | json | safe }},v=null;try{v=new URLSearchParams(location.search).get("for")}catch(e){}
if(views.indexOf(v)<0)v=g("tailor");if(views.indexOf(v)>=0)d.dataset.tailor=v;
var c=g("currency");if(c&&/^[A-Z]{3}$/.test(c))d.dataset.currency=c;})();
</script>
<style>
{% inline "site.css" %}
</style>
{%- if s.photo %}
<link rel="preload" as="image" href="{{ s.photo }}" fetchpriority="high">{% endif %}
{%- if s.avatar %}
<link rel="preload" as="image" href="{{ s.avatar }}">{% endif %}
<script src="assets/vendor/qrcode.min.js" defer></script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Person","name":{{ s.name | json | safe }},"url":{{ s.url | json | safe }},"email":{{ ("mailto:" + s.email) | json | safe }},"jobTitle":{{ s.role | json | safe }},"affiliation":{"@type":"CollegeOrUniversity","name":"Aarhus University"},"address":{"@type":"PostalAddress","addressLocality":"Aarhus","addressCountry":"DK"},"sameAs":{{ s.links | sameAs | safe }}}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{{ edge("top") }}
{{ edge("bottom") }}

<header class="topbar" id="topbar">
  <div class="wrap bar">
    <a class="brand" href="#top" aria-label="{{ s.name }}, back to top">
      {%- if s.avatar or s.photo %}<img class="mono" src="{{ s.avatar or s.photo }}" alt="" width="32" height="32" decoding="async">{% else %}<span class="mono" aria-hidden="true">{{ s.short }}</span>{% endif -%}
      {%- set nparts = s.name.split(" ") -%}<span class="brand-name"><span class="bn-first">{{ nparts[0] }}</span>{% if nparts.length > 1 %}<span class="bn-rest"> {{ nparts.slice(1).join(" ") }}</span>{% endif %}</span>
    </a>
    <div class="controls">
      <div class="seg tailor" role="radiogroup" aria-label="Tailor this page for">
        {%- for k, v in views %}
        <button type="button" class="seg-b tac" role="radio" aria-checked="{{ 'true' if k == dv else 'false' }}" data-set-tailor="{{ k }}" data-sfx="none" title="Tailor for {{ v.label | lower }}">{{ icon(v.icon) }}<span class="seg-l">{{ v.label }}</span></button>
        {%- endfor %}
      </div>
      <button type="button" class="btn icon tac" data-action="sound" data-sfx="none" aria-label="Sound effects" title="Sound effects">{{ icon("volume-high", false, "i-on") }}{{ icon("volume-xmark", false, "i-off") }}</button>
      <button type="button" class="btn icon tac" data-action="theme" aria-label="Colour theme: system" title="Colour theme">{{ icon("circle-half-stroke", false, "i-system") }}{{ icon("sun", false, "i-light") }}{{ icon("moon", false, "i-dark") }}</button>
      <button type="button" class="btn tac cv-btn" data-action="print" title="Save as PDF">{{ icon("file-arrow-down") }}<span class="cv-l">{{ perView("cv") }}</span></button>
    </div>
  </div>
</header>

<main id="main" class="wrap">
  <section class="hero" id="top" aria-label="Introduction">
    <div class="avatar" style="--i:0">
      {%- if s.ring %}
      <svg class="ring" viewBox="0 0 132 132" aria-hidden="true">
        <defs><path id="ring-path" d="M66,66 m-54,0 a54,54 0 1,1 108,0 a54,54 0 1,1 -108,0"/></defs>
        <text><textPath href="#ring-path" textLength="336" lengthAdjust="spacing">{{ s.ring }}</textPath></text>
      </svg>
      {%- endif %}
      <div class="face">
        {%- if s.photo %}<img src="{{ s.photo }}" alt="Portrait of {{ s.name }}" width="184" height="184" fetchpriority="high" decoding="async">{% else %}<span aria-hidden="true">{{ s.short }}</span>{% endif -%}
      </div>
    </div>
    <div class="intro" style="--i:1">
      <h1 class="name">{{ s.name }}</h1>
      <p class="role">{{ s.role }}</p>
      <ul class="meta">
        {%- if s.affiliation %}<li>{{ icon("building-columns") }}<span>{{ s.affiliation }}</span></li>{% endif %}
        <li>{{ icon("location-dot") }}<span>{{ s.location }}</span></li>
        <li class="no-print">{{ icon("clock") }}<span data-clock>&nbsp;</span></li>
      </ul>
      <p class="status no-print"><span class="dot" aria-hidden="true"></span>{{ perView("status") }}</p>
      <p class="print-only contact-line"><a href="mailto:{{ s.email }}">{{ s.email }}</a>{% if s.work_email %} · <a href="mailto:{{ s.work_email }}">{{ s.work_email }}</a>{% endif %} · <a href="{{ s.url }}">{{ s.url | host }}</a>{% for l in s.links %} · <a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</p>
    </div>
    <div class="bio" style="--i:2">
      {%- if s.bio.research %}
      {%- for k, v in views %}{% for para in s.bio[k] %}
      <p data-only="{{ k }}"{% if loop.first %} class="lede"{% endif %}>{{ para | md | safe }}</p>
      {%- endfor %}{% endfor %}
      {%- else %}
      {%- for para in s.bio %}<p{% if loop.first %} class="lede"{% endif %}>{{ para | md | safe }}</p>{% endfor %}
      {%- endif %}
    </div>
    <div class="actions no-print" style="--i:3">
      <button type="button" class="btn tac primary" data-action="print">{{ icon("file-arrow-down") }}<span>Download {{ perView("cv") }}</span></button>
      <ul class="profiles" aria-label="Profiles">
        {%- for l in s.links %}
        <li><a href="{{ l.url }}"{% if l.url.startsWith('http') %} rel="me noopener"{% endif %}>{{ icon(l.icon, l.brand) }}<span>{{ l.label }}</span></a></li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  {%- for key in s.tailor | sectionKeys %}
  {%- set sec = s.sections[key] or { title: key } %}
  {%- if s[key] and (s[key].length or key == "biography") %}
  <section class="sec" id="{{ key }}" data-c="{{ sec.color or 'blue' }}" aria-labelledby="h-{{ key }}"{% for k, v in views %} data-o-{{ k }}="{{ v.order | posIn(key) }}"{% endfor %}{% if (views[dv].order | posIn(key)) == 0 %} hidden{% endif %}>
    {%- if key == "biography" %}
    {%- call head(key, sec) %}
      <div class="sec-ctl no-print">
        <div class="seg sm" role="radiogroup" aria-label="Biography length">
          <button type="button" class="seg-b tac" role="radio" aria-checked="true" data-bio="len" data-val="short">Short</button>
          <button type="button" class="seg-b tac" role="radio" aria-checked="false" data-bio="len" data-val="long">Long</button>
        </div>
        <div class="seg sm" role="radiogroup" aria-label="Biography voice">
          <button type="button" class="seg-b tac" role="radio" aria-checked="true" data-bio="person" data-val="third">Third person</button>
          <button type="button" class="seg-b tac" role="radio" aria-checked="false" data-bio="person" data-val="first">First person</button>
        </div>
      </div>
    {%- endcall %}
    {%- elif key == "news" and (s.news | countTag("life")) %}
    {%- call head(key, sec) %}
      <div class="sec-ctl no-print">
        <div class="seg sm" role="radiogroup" aria-label="Show updates about">
          <button type="button" class="seg-b tac" role="radio" aria-checked="true" data-newstag="work">{{ icon("briefcase") }}<span>Work</span></button>
          <button type="button" class="seg-b tac" role="radio" aria-checked="false" data-newstag="life">{{ icon("heart") }}<span>Life</span></button>
        </div>
      </div>
    {%- endcall %}
    {%- elif key == "publications" %}
    {%- set pnote = (s.publications_note | md) if s.publications_note else ("† Equal contribution" if (s.publications | selectattr("equal") | length) else "") %}
    {%- call head(key, sec, pnote) %}
      <div class="sec-ctl no-print">
        <div class="seg sm" role="radiogroup" aria-label="List publications by">
          <button type="button" class="seg-b tac" role="radio" aria-checked="true" data-pubsort="year">{{ icon("calendar") }}<span>Year</span></button>
          <button type="button" class="seg-b tac" role="radio" aria-checked="false" data-pubsort="type">{{ icon("layer-group") }}<span>Type</span></button>
        </div>
      </div>
    {%- endcall %}
    {%- else %}
    {{ head(key, sec) }}
    {%- endif %}
    <div class="list"{% if key == "news" %} data-visible="{{ s.news_visible }}" data-show="work"{% endif %}>

    {%- if key == "biography" %}
      {%- for k, v in views %}{% for len in ["short", "long"] %}{% for per in ["third", "first"] %}
      {%- set txt = s.biography[k][len][per] if (s.biography[k] and s.biography[k][len]) else "" %}
      {%- if txt %}
      {%- set ps = txt | paras %}
      <article class="item bv rv" data-v="{{ k }}-{{ len }}-{{ per }}"{% if not (k == dv and len == "short" and per == "third") %} hidden{% endif %}>
        <div class="when">{{ ps | join(" ") | wordcount }} words</div>
        <div class="what"><div class="main">
          {%- for para in ps %}<p class="text">{{ para }}</p>{% endfor %}
          <p class="acts no-print"><button type="button" class="tl" data-action="copy" data-copy="{{ ps | join('\n\n') }}" data-toast="Biography copied">{{ icon("copy") }}Copy</button></p>
        </div></div>
      </article>
      {%- endif %}
      {%- endfor %}{% endfor %}{% endfor %}

    {%- elif key == "news" %}
      {%- for r in s.news | newestFirst | byTag %}
      {%- set n = r.n %}
      <article class="item rv news-item{% if r.ti > s.news_visible %} fold{% endif %}" data-tag="{{ r.tag }}"{% if r.tag != "work" %} hidden{% endif %}>
        <div class="when"><time datetime="{{ n.date }}">{{ n.date | ym }}</time>{% if n.date | isNew %}<span class="new" data-new="{{ n.date }}">{{ icon("wand-magic-sparkles") }}New</span>{% endif %}</div>
        <div class="what">
          <div class="main"><p class="text">{{ n.text | md | safe }}{% if n.link %} <a href="{{ n.link }}">More</a>{% endif %}</p></div>
          {%- if n.image %}<img class="thumb" src="{{ n.image }}" alt="{{ n.image_alt or '' }}" decoding="async">{% endif %}
        </div>
      </article>
      {%- endfor %}
      {%- set nWork = s.news | countTag("work") %}
      {%- if s.news.length > s.news_visible %}
      <div class="item fold-row no-print"{% if nWork <= s.news_visible %} hidden{% endif %}><div class="when"></div><div class="what">{%- set nMore = (nWork - s.news_visible) if nWork > s.news_visible else 0 %}<button type="button" class="tl fold-btn" data-action="fold" aria-expanded="false">{{ icon("chevron-down") }}<span>Show {{ nMore }} more {{ "update" if nMore == 1 else "updates" }}</span></button></div></div>
      {%- endif %}

    {%- elif key == "publications" %}
      {%- for r in s.publications | newestFirst | pubRows(s.pub_groups) %}
      {%- set p = r.p %}
      {%- if r.head %}
      <h3 class="subhead rv" data-sub>{{ r.year }}</h3>
      {%- endif %}
      <article class="item pub rv" id="{{ p.id }}" data-gi="{{ r.gi }}">
        <div class="when pn" title="{{ r.group }}">{% if r.label %}{{ r.label }}{% else %}{{ icon(r.icon or "file") }}<span class="sr">{{ r.group }}</span>{% endif %}</div>
        <div class="what">
          <div class="main">
            {%- set rt = p | rateFor(s.venues) %}
            <p class="text cite-r" data-only="research">{{ p | cite(s.name, awardRefs) | safe }}{% if rt %} <span class="vrate">[{{ rt.rate }} acc. rate{% if rt.year %}, {{ rt.year }}{% endif %}]</span>{% endif %}</p>
            {%- set u = p | titleUrl %}
            <div class="cite-i" data-only="industry">
              <h4 class="t">{% if u %}<a href="{{ u }}">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</h4>
              <p class="venue">{{ p | venueLine(awardRefs) | safe }}{% if rt %}<span class="sep">·</span><span class="vrate">{{ rt.rate }} acceptance rate</span>{% endif %}</p>
              <p class="sub">{{ p.authors | authorList(s.name, p.equal) | safe }}</p>
            </div>
            {%- if p.images %}
            <div class="gal no-print" data-gal>
              <div class="gallery" role="list" aria-label="Images for {{ p.title }}">
                {%- for im in p.images %}{% set dm = im.src | imgDims %}
                <button type="button" class="g-item" role="listitem" data-src="{{ im.src }}" data-cap="{{ im.caption or im.alt }}"{% if dm %} style="--ar:{{ dm[0] }}/{{ dm[1] }}"{% endif %} aria-label="View image {{ loop.index }} of {{ p.images.length }}{% if im.alt %}: {{ im.alt }}{% endif %}"><img src="{{ im.src }}" alt=""{% if dm %} width="{{ dm[0] }}" height="{{ dm[1] }}"{% endif %} decoding="async" fetchpriority="low"></button>
                {%- endfor %}
              </div>
              <div class="pb pb-l" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
              <div class="pb pb-r" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
              <button type="button" class="g-nav tac g-prev" tabindex="-1" aria-hidden="true" data-dir="-1">{{ icon("chevron-left") }}</button>
              <button type="button" class="g-nav tac g-next" tabindex="-1" aria-hidden="true" data-dir="1">{{ icon("chevron-right") }}</button>
            </div>
            {%- endif %}
            {%- if p.links or p.bibtex !== false %}
            <p class="acts no-print">
              {%- for k, l in p.links %}<a class="tl" href="{{ l }}">{{ icon(actIcons[k] or "link") }}{{ actLabels[k] or k }}</a>{% endfor %}
              {%- if p.bibtex !== false %}<button type="button" class="tl" data-action="copy" data-copy="{{ p | bibtex(s.name) }}" data-toast="BibTeX copied">{{ icon("quote-right") }}BibTeX</button>{% endif %}
            </p>
            {%- endif %}
          </div>
          {%- if p.image and not p.images %}<img class="thumb" src="{{ p.image }}" alt="" decoding="async">{% endif %}
        </div>
      </article>
      {%- endfor %}

    {%- elif key == "projects" %}
      {%- set anySel = s.projects | selectattr("selected") | length %}
      {%- for p in s.projects | selectedFirst %}
      {%- set purl = (p.links.web if p.links else "") or (p.links.code if p.links else "") -%}
      <article class="item rv{% if anySel and not p.selected %} fold{% endif %}" id="{{ p | entryId('project') }}">
        <div class="when">{{ projectKinds[p.kind] or p.kind }}</div>
        <div class="what">
          <div class="main">
            <h3 class="t">{% if purl %}<a href="{{ purl }}">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</h3>
            <p class="text">{{ p.summary | md | safe }}</p>
            {%- if p.tech %}<p class="tech">{{ p.tech | join(" · ") }}</p>{% endif %}
            {%- if p.links %}<p class="acts no-print">{% for k, u in p.links %}<a class="tl" href="{{ u }}">{% if k == "code" and "github.com" in u %}{{ icon("github", true) }}{% else %}{{ icon(actIcons[k] or "link") }}{% endif %}{{ "Live" if k == "web" else (actLabels[k] or k) }}</a>{% endfor %}</p>{% endif %}
          </div>
          {%- if p.image %}<img class="thumb" src="{{ p.image }}" alt="" decoding="async">{% endif %}
        </div>
      </article>
      {%- endfor %}
      {%- if anySel and anySel < s.projects.length %}
      <div class="item fold-row no-print"><div class="when"></div><div class="what">{%- set nMore = (s.projects.length - anySel) %}<button type="button" class="tl fold-btn" data-action="fold" aria-expanded="false">{{ icon("chevron-down") }}<span>Show {{ nMore }} more {{ "project" if nMore == 1 else "projects" }}</span></button></div></div>
      {%- endif %}

    {%- elif key == "experience" %}
      {%- for e in s.experience | newestFirst %}
      <article class="item rv" id="{{ e | entryId('experience') }}">
        <div class="when">{{ e | period }}</div>
        <div class="what"><div class="main">
          <h3 class="t">{{ e.role }}</h3>
          <p class="sub">{{ e.org }}{% if e.place %}<span class="sep">·</span>{{ e.place }}{% endif %}</p>
          {%- if e.summary %}<p class="text"{% if e.highlights %} data-only="research"{% endif %}>{{ e.summary | md | safe }}</p>{% endif %}
          {%- if e.highlights %}<ul class="bullets"{% if e.summary %} data-only="industry"{% endif %}>{% for h in e.highlights %}<li>{{ h | md | safe }}</li>{% endfor %}</ul>{% endif %}
          {%- if e.tags %}<p class="tech">{{ e.tags | join(" · ") }}</p>{% endif %}
        </div></div>
      </article>
      {%- endfor %}

    {%- elif key == "teaching" %}
      {%- for t in s.teaching | newestFirst %}
      <article class="item rv" id="{{ t | entryId('teaching') }}">
        <div class="when">{{ t.when }}</div>
        <div class="what"><div class="main"><h3 class="t">{{ t.role }}</h3><p class="sub">{{ t.org }}{% if t.lead %}<span class="sep">·</span>Course led by {{ t.lead }}{% endif %}</p>{% if t.detail %}<p class="text">{{ t.detail | md | safe }}</p>{% endif %}</div></div>
      </article>
      {%- endfor %}

    {%- elif key == "talks" %}
      {%- if s.travel and s.travel.length %}
      {%- set tm = s.travel | travelMap %}
      {%- set nEv = tm.events.length %}
      <figure class="map rv no-print" data-map>
        <div class="map-view">
          <svg class="map-svg" viewBox="0 150 1000 560" preserveAspectRatio="xMidYMid slice" role="img" aria-label="World map of the places in this timeline">
            <rect class="map-sea" x="-1000" y="-1000" width="3000" height="3000"/>
            <path class="map-land" d="{{ tm.land }}"/>
            <path class="map-borders" d="{{ tm.borders }}"/>
            <g class="map-routes">{% for e in tm.events %}{% if e.arc %}<path class="map-route" data-i="{{ loop.index0 }}" data-c="{{ kindColor[e.kind] }}" d="{{ e.arc }}" pathLength="1"/>{% endif %}{% endfor %}</g>
          </svg>
          <div class="map-pins">
            {%- for e in tm.events %}
            <button type="button" class="pin" data-i="{{ loop.index0 }}" data-x="{{ e.x }}" data-y="{{ e.y }}" data-ox="{{ e.ox if e.ox !== null else '' }}" data-oy="{{ e.oy if e.oy !== null else '' }}" data-when="{{ e.when }}" data-c="{{ kindColor[e.kind] }}" aria-label="{{ e.place }}, {{ e.when }}: {{ e.label }}">{{ icon(kindIcon[e.kind]) }}<span class="pin-label">{{ e.place }}</span></button>
            {%- endfor %}
          </div>
          <div class="map-cards" aria-live="polite">
            {%- for e in tm.events %}
            <div class="map-card" data-i="{{ loop.index0 }}" data-c="{{ kindColor[e.kind] }}"{% if not loop.last %} hidden{% endif %}>
              <p class="mc-kind">{{ icon(kindIcon[e.kind]) }}{{ kindName[e.kind] }}<span class="sep">·</span>{{ e.when }}</p>
              <p class="mc-place">{{ e.place }}, {{ e.country }}</p>
              <p class="mc-what">{% if e.ref %}<a href="#{{ e.ref }}">{{ e.label }}</a>{% else %}{{ e.label }}{% endif %}</p>
            </div>
            {%- endfor %}
          </div>
        </div>
        <figcaption class="map-ctl">
          <button type="button" class="btn icon tac map-play" aria-label="Replay the timeline" title="Replay">{{ icon("play", false, "i-play") }}{{ icon("pause", false, "i-pause") }}</button>
          <div class="map-track">
            <input type="range" class="map-range" min="0" max="{{ nEv - 1 }}" step="any" value="{{ nEv - 1 }}" aria-label="Move through time">
            <div class="map-ticks" aria-hidden="true">
              {%- set lastY = "" %}
              {%- for e in tm.events %}
              <span class="tick" style="left:{{ (loop.index0 / (nEv - 1) * 100) | round(2) }}%" data-c="{{ kindColor[e.kind] }}"><i></i>{% if loop.first or tm.events[loop.index0 - 1].year != e.year %}<b>{{ e.year }}</b>{% endif %}</span>
              {%- endfor %}
            </div>
          </div>
          <ul class="map-legend" aria-label="Legend">{% for k, nm in kindName %}<li data-c="{{ kindColor[k] }}">{{ icon(kindIcon[k]) }}{{ nm }}</li>{% endfor %}</ul>
        </figcaption>
      </figure>
      {%- endif %}
      {%- for t in s.talks | newestFirst %}
      <article class="item rv" id="{{ t | entryId('talk') }}">
        <div class="when">{{ t.date | ym }}</div>
        <div class="what"><div class="main"><h3 class="t">{% if t.ref %}<a href="#{{ t.ref }}">{{ t.title }}</a>{% elif t.link %}<a href="{{ t.link }}">{{ t.title }}</a>{% else %}{{ t.title }}{% endif %}</h3><p class="sub">{{ t.event }}</p></div></div>
      </article>
      {%- endfor %}

    {%- elif key == "service" %}
      {%- for r in s.service | newestFirst %}
      <article class="item rv{% if s.service_visible and loop.index > s.service_visible %} fold{% endif %}" id="{{ r | entryId('service') }}">
        {%- if r.reviews %}
        <div class="when">{{ r.venue | year4 }}</div>
        <div class="what"><div class="main"><h3 class="t">Reviewer, {{ r.venue | noYear }}, {{ r.track }}</h3><p class="sub">{{ r.reviews }} review{% if r.reviews != 1 %}s{% endif %}{% if r.note %}<span class="sep">·</span><span class="award">{{ icon("medal") }}{{ r.note }}</span>{% endif %}</p></div></div>
        {%- else %}
        <div class="when">{{ r.when }}</div>
        <div class="what"><div class="main"><h3 class="t">{{ r.role }}</h3>{% if r.org %}<p class="sub">{{ r.org }}</p>{% endif %}{% if r.detail %}<p class="text">{{ r.detail | md | safe }}</p>{% endif %}</div></div>
        {%- endif %}
      </article>
      {%- endfor %}
      {%- if s.service_visible and s.service.length > s.service_visible %}
      <div class="item fold-row no-print"><div class="when"></div><div class="what">{%- set nMore = (s.service.length - s.service_visible) %}<button type="button" class="tl fold-btn" data-action="fold" aria-expanded="false">{{ icon("chevron-down") }}<span>Show {{ nMore }} more {{ "review" if nMore == 1 else "reviews" }}</span></button></div></div>
      {%- endif %}

    {%- elif key == "grants" %}
      {%- for g in s.grants | newestFirst %}
      {%- set m = g.amount | money %}
      <article class="item rv" id="{{ g | entryId('grant') }}">
        <div class="when">{{ g.year }}</div>
        <div class="what"><div class="main">
          <h3 class="t">{{ g.title }}</h3>
          {%- if g.amount %}
          <p class="amt">{{ g.amount }}
            {%- if m %}{% set cv = m | convert(cur, fx) %} <button type="button" class="fx" data-fx data-v="{{ m.v }}" data-c="{{ m.c }}" aria-haspopup="menu" aria-expanded="false" title="Show in another currency"{% if m.c == cur or cv === null %} hidden{% endif %}>(≈&nbsp;<span class="fx-v">{{ cv | fmtMoney(cur) if cv !== null else "" }}</span>{{ icon("chevron-down", false, "fx-chev") }})</button>{% endif %}
          </p>
          {%- endif %}
          {%- if g.by %}<p class="sub">{{ g.by }}</p>{% endif %}
          {%- if g.for %}<p class="sub">{{ g.for | md | safe }}</p>{% endif %}
        </div></div>
      </article>
      {%- endfor %}

    {%- elif key == "awards" %}
      {%- for a in s.awards | newestFirst %}
      <article class="item rv" id="{{ a | entryId('award') }}">
        <div class="when">{{ a.year }}</div>
        <div class="what"><div class="main"><h3 class="t">{{ a.title }}</h3><p class="sub">{{ a.by }}</p>{% if a.for %}<p class="sub">For {% if a.ref %}<a href="#{{ a.ref }}">{{ a.for }}</a>{% elif a.link %}<a href="{{ a.link }}">{{ a.for }}</a>{% else %}{{ a.for }}{% endif %}</p>{% endif %}{% if a.detail %}<p class="text">{{ a.detail | md | safe }}</p>{% endif %}</div></div>
      </article>
      {%- endfor %}

    {%- elif key == "education" %}
      {%- for e in s.education | newestFirst %}
      <article class="item rv" id="{{ e | entryId('education') }}">
        <div class="when">{{ e | period }}</div>
        <div class="what"><div class="main"><h3 class="t">{{ e.degree }}</h3><p class="sub">{{ e.org }}{% if e.place %}<span class="sep">·</span>{{ e.place }}{% endif %}</p>{% if e.detail %}<p class="text">{{ e.detail | md | safe }}</p>{% endif %}</div></div>
      </article>
      {%- endfor %}

    {%- elif key == "certifications" %}
      {%- set anySel = s.certifications | selectattr("selected") | length %}
      {%- for c in s.certifications | newestFirst | selectedFirst %}
      <article class="item rv{% if anySel and not c.selected %} fold{% endif %}" id="{{ c | entryId('cert') }}">
        <div class="when">{{ c.year }}</div>
        <div class="what"><div class="main"><h3 class="t">{% if c.url %}<a href="{{ c.url }}">{{ c.title }}</a>{% else %}{{ c.title }}{% endif %}</h3><p class="sub">{{ c.by }}</p>{% if c.detail %}<p class="text">{{ c.detail | md | safe }}</p>{% endif %}</div></div>
      </article>
      {%- endfor %}
      {%- if anySel and anySel < s.certifications.length %}
      <div class="item fold-row no-print"><div class="when"></div><div class="what">{%- set nMore = (s.certifications.length - anySel) %}<button type="button" class="tl fold-btn" data-action="fold" aria-expanded="false">{{ icon("chevron-down") }}<span>Show {{ nMore }} more {{ "certification" if nMore == 1 else "certifications" }}</span></button></div></div>
      {%- endif %}

    {%- elif key == "skills" %}
      {%- for g in s.skills %}
      <article class="item rv">
        <div class="when">{{ g.group }}</div>
        <div class="what"><div class="main"><ul class="chips">{% for it in g.items %}<li>{{ it }}</li>{% endfor %}</ul></div></div>
      </article>
      {%- endfor %}
    {%- endif %}

    </div>
  </section>
  {%- endif %}
  {%- endfor %}

  {%- set cf = s.contact_form or {} %}
  {%- set csec = s.sections.contact or { title: "Contact", icon: "envelope" } %}
  <section class="sec contact no-print" id="contact" data-c="{{ csec.color or 'blue' }}" aria-labelledby="h-contact">
    {{ head("contact", csec) }}
    <form class="mail rv" id="contact-form" novalidate data-endpoint="{{ cf.endpoint }}" data-subject="{{ cf.subject }}">
      <div class="mail-bar" aria-hidden="true"><span class="lights"><i></i><i></i><i></i></span><span class="mail-title">New message</span></div>
      <div class="mail-row">
        <label class="mail-k" for="cf-to" id="cf-to-label">To</label>
        <div class="to-chip">
          {%- if s.avatar or s.photo %}<img src="{{ s.avatar or s.photo }}" alt="" width="24" height="24">{% endif %}
          <select id="cf-to" name="to">
            {%- for r in cf.recipients or [{ label: "Email", email: s.email }] %}
            <option value="{{ r.email }}" data-key="{{ r.access_key }}" data-label="{{ r.label }}">{{ r.email }} · {{ r.label }}</option>
            {%- endfor %}
          </select>
          {{ icon("chevron-down", false, "chev") }}
          <button type="button" class="dd-btn" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="cf-to-label dd-val" hidden><span class="dd-val" id="dd-val"></span>{{ icon("chevron-down", false, "chev") }}</button>
        </div>
      </div>
      <div class="mail-row">
        <label class="mail-k" for="cf-name">From</label>
        <div class="mail-from">
          <input id="cf-name" name="name" type="text" autocomplete="name" placeholder="Your name" required>
          <input id="cf-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-label="Your email" required>
        </div>
      </div>
      <div class="mail-row">
        <label class="mail-k" for="cf-subject">Subject</label>
        <input id="cf-subject" name="subject" type="text" placeholder="What is this about?">
      </div>
      <textarea id="cf-message" class="mail-body" name="message" rows="7" placeholder="Write your message…" aria-label="Message" required></textarea>
      <input class="hp" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="mail-foot">
        <button type="submit" class="btn tac primary">{{ icon("paper-plane") }}<span>Send</span></button>
        <button type="button" class="btn icon tac" data-action="copy-to" title="Copy this address" aria-label="Copy this address">{{ icon("copy") }}</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </section>
</main>

<footer class="foot no-print" id="footer">
  <div class="wrap">
    <p class="foot-name">{{ s.name }}</p>
    <div class="foot-grid">
      <div class="foot-col">
        <p class="foot-muted">{{ s.name }}</p>
        <p><a class="ob" href="mailto:{{ s.email }}">{{ s.email | atSign }}</a></p>
        {%- if s.work_email %}<p><a class="ob" href="mailto:{{ s.work_email }}">{{ s.work_email | atSign }}</a></p>{% endif %}
      </div>
      <ul class="foot-col foot-links">
        {%- for l in s.links %}
        <li><a href="{{ l.url }}" rel="me noopener">{{ icon(l.icon, l.brand) }}<span>{{ l.label }}</span></a></li>
        {%- endfor %}
      </ul>
      <p class="foot-col foot-muted">{{ s.footer | md | safe }}</p>
    </div>
    <p class="foot-meta">© {% buildYear %} {{ s.name }}<span class="sep">·</span>Updated {% buildDate %}<span class="sep">·</span><span data-clock>&nbsp;</span>{% if s.analytics and s.analytics.gtm %}<span class="sep">·</span><button type="button" class="tl cookie-link" data-cookie-settings>Cookie settings</button>{% endif %}<span class="kb-note"><span class="sep">·</span>Hold <kbd>⌘</kbd> or <kbd>Ctrl</kbd> to move around by keyboard</span></p>
  </div>
</footer>

<div class="floats no-print" inert>
  <a class="btn tac icon float float-l" href="#contact" data-float="mail" aria-label="Email" title="Email">{{ icon("envelope") }}</a>
  <a class="btn tac icon float float-r" href="#top" aria-label="Back to top" title="Back to top">{{ icon("arrow-up") }}</a>
</div>

<div class="pop dd-menu" role="listbox" aria-label="Recipient" tabindex="-1" hidden></div>
<div class="pop fx-menu" role="menu" aria-label="Currency" hidden>
  <p class="fx-head"></p>
  <div class="fx-list"></div>
  <p class="fx-note"></p>
</div>
<script type="application/json" id="fx-data">{{ { rates: fx.rates, date: fx.date, list: s.currencies, def: cur } | json | safe }}</script>

<dialog class="lightbox" aria-label="Image viewer">
  <figure><img alt=""><figcaption><span class="lb-cap"></span><span class="lb-n"></span></figcaption></figure>
  <button type="button" class="btn icon tac lb-prev" aria-label="Previous image">{{ icon("chevron-left") }}</button>
  <button type="button" class="btn icon tac lb-next" aria-label="Next image">{{ icon("chevron-right") }}</button>
  <button type="button" class="btn icon tac lb-close" aria-label="Close">{{ icon("xmark") }}</button>
</dialog>

<div class="kb" aria-hidden="true" hidden><div class="kb-layer"></div><p class="kb-legend"><span><kbd>a</kbd>–<kbd>z</kbd> click</span><span><kbd>⇧</kbd> + code focus</span><span><kbd>1</kbd>–<kbd>9</kbd> section</span><span><kbd>↑</kbd><kbd>↓</kbd> previous, next</span><span><kbd>Esc</kbd> close</span></p></div>
<button type="button" class="back-chip" hidden>{{ icon("arrow-left") }}<span>Back</span></button>
{%- if s.analytics and s.analytics.gtm %}
<section class="consent" aria-labelledby="consent-title" hidden>
  <div class="consent-head">{{ icon("cookie-bite", false, "consent-ic") }}<h2 id="consent-title">Would you like some cookies?</h2></div>
  <p>Just the Google Analytics kind. They show me how people find this site, and Google handles the data. No ads, and everything works the same if you say no. <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener">How Google uses this<span class="sr"> (opens in a new tab)</span></a></p>
  <div class="consent-row"><button type="button" class="btn tac primary" data-consent="yes">Yes, please</button><button type="button" class="btn tac" data-consent="no">No, thanks</button></div>
</section>
{%- endif %}
<template id="ic-check">{{ icon("check", false, "chk") }}</template>
<div class="qr-pop" aria-hidden="true"><div class="qr-code"></div><div class="qr-cap"></div></div>
<div class="toast" role="status" aria-live="polite"></div>

<script>
{% inline "site.js" %}
</script>
</body>
</html>
